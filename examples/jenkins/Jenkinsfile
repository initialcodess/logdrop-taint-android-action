// LogDrop Taint (Android) on Jenkins. Any agent with a JDK 17 works.
pipeline {
    agent any

    environment {
        LOGDROP_VERSION = 'v1.0.0'
        // Pinned to a COMMIT, not a tag — see examples/README.md.
        LOGDROP_ACTION_SHA = '77f8b4934122e483489d76466c33d80a92e7fa8f'
        LOGDROP_LICENSE = credentials('logdrop-license')
    }

    stages {
        stage('Install LogDrop Taint') {
            steps {
                sh '''
                    curl -fsSL -o install.sh \
                      "https://raw.githubusercontent.com/initialcodess/logdrop-taint-android-action/$LOGDROP_ACTION_SHA/examples/install-logdrop-taint.sh"
                    chmod +x install.sh
                    LOGDROP_DIR="$WORKSPACE/.logdrop" ./install.sh
                '''
            }
        }
        stage('Scan') {
            steps {
                sh '''
                    java -jar "$WORKSPACE/.logdrop/logdrop-taint-android-$LOGDROP_VERSION.jar" app/src \
                      --sarif logdrop-taint.sarif --repo-root "$WORKSPACE" \
                      --verbose --fail-on-findings
                '''
            }
        }
    }

    post {
        // Always, because a report with findings is the one worth having.
        always {
            sh '''
                curl -fsSL -o report.sh \
                  https://raw.githubusercontent.com/initialcodess/logdrop-taint-android-action/$LOGDROP_ACTION_SHA/examples/report-to-panel.sh
                APP_NAME="$JOB_NAME" VERSION="$BRANCH_NAME" COMMIT="$GIT_COMMIT" \
                  bash report.sh logdrop-taint.sarif || true
            '''
            archiveArtifacts artifacts: 'logdrop-taint.sarif', allowEmptyArchive: true
        }
    }
}
